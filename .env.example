# Firebase 프로젝트 설정 콘솔 > 프로젝트 설정 > 일반 > 내 앱 에서 확인
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phase 4: App Check (Gemini/Firebase AI Logic 보호용) - reCAPTCHA Enterprise 사용
# 프로덕션 배포 시 필요 - Firebase 콘솔 > App Check > 앱 등록 > reCAPTCHA Enterprise 사이트 키
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# 로컬 개발 전용(선택) - 최초 실행 시 브라우저 콘솔에 뜨는 디버그 토큰을 Firebase 콘솔의
# App Check > Debug tokens에 등록한 뒤 여기 넣으면 매번 새 토큰을 등록할 필요가 없다.
# 비워두면 실행할 때마다 새 디버그 토큰이 발급되어 콘솔에 출력된다.
VITE_APPCHECK_DEBUG_TOKEN=

# Phase 6: Google Calendar 연동 (공개 OAuth 클라이언트 ID만 사용, client secret 없음)
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# 에서 발급받은 클라이언트 ID를 넣는다. 이 값은 공개되어도 되는 값이다(client secret이 아님).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# 개인정보처리방침(/privacy) 페이지 하단에 표시할 문의 이메일 (선택).
# 비워두면 문의 섹션에 이메일 대신 "문의 채널이 아직 설정되지 않았습니다."가 표시된다.
VITE_PRIVACY_CONTACT_EMAIL=
